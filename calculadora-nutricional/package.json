{
  "name": "web",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "postinstall": "npx prisma generate",
    "build": "npx prisma generate --schema=./prisma/schema.prisma && next build",
    "db:push": "npx prisma db push --schema=./prisma/schema.prisma",
    "start": "next start",
    "lint": "eslint",
    "security:check": "node scripts/security-check.mjs && npm audit --audit-level=moderate",
    "seed": "npx -y tsx scripts/seed.ts",
    "seed-user": "npx -y tsx scripts/seed-test-user.js",
    "test-db": "npx -y tsx scripts/test-db.js",
    "test:modules": "rm -rf /tmp/soizi-module-tests && tsc src/features/saas/domain/modules.ts src/features/saas/domain/module-access.ts src/features/saas/domain/module-access.test.ts --outDir /tmp/soizi-module-tests --module commonjs --moduleResolution node --target es2022 --esModuleInterop --skipLibCheck && node --test /tmp/soizi-module-tests/module-access.test.js",
    "verify:modules:runtime": "node scripts/verify-modules-runtime.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.12.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "exceljs": "^4.4.0",
    "html-to-image": "^1.11.13",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.562.0",
    "next": "^16.2.10",
    "next-auth": "^4.24.13",
    "next-themes": "^0.4.6",
    "otplib": "^13.4.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bing-translate-api": "^4.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.14",
    "uuid": "^11.1.1"
  }
}
