generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

enum DocumentType {
  NUTRITION_TABLE_ONLY
  PRODUCT_TECHNICAL_SHEET
  MATERIAL_SPECIFICATION
  LAB_REPORT
  CERTIFICATE
  UNKNOWN
}

enum ExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVIEW
}

enum TechnicalFieldCategory {
  REGULATORY
  DECLARATION
  SENSORY
  PHYSICOCHEMICAL
  MICROBIOLOGICAL
  CONTAMINANT
  TRACEABILITY
  LOGISTICS
  CERTIFICATION
  WARNING
}

enum EnterpriseApprovalStatus {
  DRAFT
  QUALITY
  REGULATORY
  MARKETING
  APPROVED
}

enum EnterpriseExportType {
  PNG
  JSON
  GS1_DIGITAL_LINK
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum SaaSModuleKey {
  TABLES
  CUSTOM_INGREDIENTS
  TECHNICAL_SHEETS
  OPEN_FOOD_FACTS
  ENTERPRISE_LABELS
  EXPORTS
  AI_IMPORT
  API_ACCESS
  SETTINGS
}

model User {
  id                        String                     @id @default(cuid())
  email                     String                     @unique
  password                  String?
  name                      String?
  twoFactorEnabled          Boolean                    @default(false)
  twoFactorSecret           String?                    @db.Text
  twoFactorPendingSecret    String?                    @db.Text
  twoFactorConfirmedAt      DateTime?
  twoFactorLastUsedAt       DateTime?
  resetPasswordToken        String?                    @unique @db.Text
  resetPasswordExpiresAt    DateTime?
  termsAcceptedAt           DateTime?
  privacyAcceptedAt         DateTime?
  legalDocumentVersion      String?
  ownedOrganizations        Organization[]             @relation("OrganizationOwner")
  organizationMemberships   OrganizationMember[]
  securityAuditLogs         SecurityAuditLog[]
  tables                    GeneratedTable[]
  customIngredients         CustomIngredient[]
  technicalDocuments        TechnicalDocument[]
  technicalSheetExtractions TechnicalSheetExtraction[]
  enterpriseLabelProjects   EnterpriseLabelProject[]
  enterpriseLabelVersions   EnterpriseLabelVersion[]
  enterpriseApprovals       EnterpriseApproval[]
  enterpriseExports         EnterpriseExport[]
  apiAccessTokens           ApiAccessToken[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
}

model Organization {
  id      String             @id @default(cuid())
  ownerId String
  owner   User               @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  name    String
  slug    String             @unique
  status  OrganizationStatus @default(ACTIVE)

  members           OrganizationMember[]
  profiles          OrganizationProfile[]
  entitlements      OrganizationEntitlement[]
  securityAuditLogs SecurityAuditLog[]
  apiAccessTokens   ApiAccessToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
}

model OrganizationMember {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId      String?
  profile        OrganizationProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  role           OrganizationRole     @default(MEMBER)
  active         Boolean              @default(true)

  moduleGrants ParticipantModuleGrant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([organizationId, role, createdAt])
  @@index([organizationId, profileId])
  @@index([userId])
  @@index([userId, active, createdAt])
  @@index([profileId])
  @@index([role])
}

model OrganizationProfile {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?      @db.Text
  systemKey      String

  members     OrganizationMember[]
  permissions OrganizationProfilePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@unique([organizationId, systemKey])
  @@index([organizationId])
  @@index([organizationId, createdAt])
}

model OrganizationProfilePermission {
  id                    String              @id @default(cuid())
  organizationProfileId String
  profile               OrganizationProfile @relation(fields: [organizationProfileId], references: [id], onDelete: Cascade)
  moduleKey             SaaSModuleKey
  enabled               Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationProfileId, moduleKey])
  @@index([moduleKey])
  @@index([enabled])
}

model OrganizationEntitlement {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  moduleKey      SaaSModuleKey
  enabled        Boolean       @default(true)
  usageLimit     Int?
  source         String        @default("MANUAL")
  expiresAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, moduleKey])
  @@index([moduleKey])
  @@index([enabled])
}

model ParticipantModuleGrant {
  id                   String             @id @default(cuid())
  organizationMemberId String
  organizationMember   OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)
  moduleKey            SaaSModuleKey
  enabled              Boolean            @default(true)
  usageLimit           Int?
  expiresAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationMemberId, moduleKey])
  @@index([moduleKey])
  @@index([enabled])
}

model ApiAccessToken {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  tokenHash      String       @unique
  tokenPrefix    String
  lastFour       String
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, userId, revokedAt])
  @@index([expiresAt])
}

model SecurityAuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  riskLevel      String        @default("INFO")
  ipHash         String?
  userAgent      String?       @db.Text
  metadata       Json?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([riskLevel])
  @@index([createdAt])
}

model RateLimitBucket {
  id        String   @id @default(cuid())
  scope     String
  keyHash   String
  attempts  Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, keyHash])
  @@index([resetAt])
}

model Ingredient {
  id         String  @id @default(cuid())
  name       String
  searchName String  @default("")
  energy     Float // kcal
  carbs      Float // g
  protein    Float // g
  fatTotal   Float // g
  fatSat     Float // g
  fatTrans   Float // g
  fiber      Float // g
  sodium     Float // mg
  sugarTotal Float? // g
  sugarAdded Float?  @default(0) // g
  origin     String? // "TACO", etc.

  // Micronutrients
  fatMono         Float? @default(0)
  fatPoly         Float? @default(0)
  omega6          Float? @default(0)
  omega3          Float? @default(0)
  cholesterol     Float? @default(0)
  customNutrients Json?

  vitaminA        Float? @default(0)
  vitaminD        Float? @default(0)
  vitaminE        Float? @default(0)
  vitaminK        Float? @default(0)
  vitaminC        Float? @default(0)
  thiamin         Float? @default(0)
  riboflavin      Float? @default(0)
  niacin          Float? @default(0)
  vitaminB6       Float? @default(0)
  biotin          Float? @default(0)
  folicAcid       Float? @default(0) // folate
  pantothenicAcid Float? @default(0)
  vitaminB12      Float? @default(0)

  calcium    Float? @default(0)
  chloride   Float? @default(0)
  copper     Float? @default(0)
  chromium   Float? @default(0)
  iron       Float? @default(0)
  fluoride   Float? @default(0)
  phosphorus Float? @default(0)
  iodine     Float? @default(0)
  magnesium  Float? @default(0)
  manganese  Float? @default(0)
  molybdenum Float? @default(0)
  potassium  Float? @default(0)
  selenium   Float? @default(0)
  zinc       Float? @default(0)
  choline    Float? @default(0)

  @@index([name])
}

model CustomIngredient {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  name               String
  searchName         String   @default("")
  energy             Float
  carbs              Float
  protein            Float
  fatTotal           Float
  fatSat             Float
  fatTrans           Float
  fiber              Float
  sodium             Float
  sugarTotal         Float
  sugarAdded         Float    @default(0)
  manufacturer       String?
  productCode        String?
  ingredientsText    String?  @db.Text
  containsGluten     Boolean?
  glutenText         String?  @db.Text
  allergensText      String?  @db.Text
  mayContainText     String?  @db.Text
  sourceType         String?  @default("MANUAL")
  sourceDocumentId   String?
  sourceExtractionId String?

  // Micronutrients
  fatMono         Float? @default(0)
  fatPoly         Float? @default(0)
  omega6          Float? @default(0)
  omega3          Float? @default(0)
  cholesterol     Float? @default(0)
  customNutrients Json?

  vitaminA        Float? @default(0)
  vitaminD        Float? @default(0)
  vitaminE        Float? @default(0)
  vitaminK        Float? @default(0)
  vitaminC        Float? @default(0)
  thiamin         Float? @default(0)
  riboflavin      Float? @default(0)
  niacin          Float? @default(0)
  vitaminB6       Float? @default(0)
  biotin          Float? @default(0)
  folicAcid       Float? @default(0) // folate
  pantothenicAcid Float? @default(0)
  vitaminB12      Float? @default(0)

  calcium    Float? @default(0)
  chloride   Float? @default(0)
  copper     Float? @default(0)
  chromium   Float? @default(0)
  iron       Float? @default(0)
  fluoride   Float? @default(0)
  phosphorus Float? @default(0)
  iodine     Float? @default(0)
  magnesium  Float? @default(0)
  manganese  Float? @default(0)
  molybdenum Float? @default(0)
  potassium  Float? @default(0)
  selenium   Float? @default(0)
  zinc       Float? @default(0)
  choline    Float? @default(0)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([name])
}

model GeneratedTable {
  id                 String                   @id @default(cuid())
  userId             String
  user               User                     @relation(fields: [userId], references: [id])
  title              String
  portion            Float
  uom                String // "g" or "ml"
  householdMeasure   String
  popGroup           String // "adultos", etc.
  packageContent     Float?
  servingsPerPackage String?
  suggestedFoodGroup String?
  suggestedProduct   String?
  uiState            Json?
  items              TableItem[]
  enterpriseProjects EnterpriseLabelProject[]
  enterpriseVersions EnterpriseLabelVersion[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, updatedAt(sort: Desc)])
}

model TableItem {
  id      String         @id @default(cuid())
  tableId String
  table   GeneratedTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  name         String
  source       String?
  quantity     Float // g
  isAddedSugar Boolean @default(false)

  // Snapshotted nutritional values (per 100g)
  energy     Float
  carbs      Float
  protein    Float
  fatTotal   Float
  fatSat     Float
  fatTrans   Float
  fiber      Float
  sodium     Float
  sugarTotal Float?
  sugarAdded Float? @default(0)

  // Optional IN 75 Annex II components snapshotted per 100g.
  fatMono         Float?
  fatPoly         Float?
  omega6          Float?
  omega3          Float?
  cholesterol     Float?
  customNutrients Json?

  vitaminA        Float?
  vitaminD        Float?
  vitaminE        Float?
  vitaminK        Float?
  vitaminC        Float?
  thiamin         Float?
  riboflavin      Float?
  niacin          Float?
  vitaminB6       Float?
  biotin          Float?
  folicAcid       Float?
  pantothenicAcid Float?
  vitaminB12      Float?

  calcium    Float?
  chloride   Float?
  copper     Float?
  chromium   Float?
  iron       Float?
  fluoride   Float?
  phosphorus Float?
  iodine     Float?
  magnesium  Float?
  manganese  Float?
  molybdenum Float?
  potassium  Float?
  selenium   Float?
  zinc       Float?
  choline    Float?

  @@index([tableId])
}

model TechnicalDocument {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fileName String
  fileUrl  String?
  mimeType String?

  documentType DocumentType     @default(UNKNOWN)
  status       ExtractionStatus @default(PENDING)

  rawText       String? @db.Text
  extractedJson Json?
  errorMessage  String? @db.Text

  confidence Float?

  extraction TechnicalSheetExtraction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
}

model TechnicalSheetExtraction {
  id String @id @default(cuid())

  documentId String            @unique
  document   TechnicalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productName  String?
  productCode  String?
  manufacturer String?
  brand        String?

  version      String?
  revision     String?
  issueDate    DateTime?
  revisionDate DateTime?

  description          String? @db.Text
  applicationAndDosage String? @db.Text
  compositionText      String? @db.Text
  ingredientsText      String? @db.Text

  containsGluten Boolean?
  glutenText     String?  @db.Text

  containsGmo Boolean?
  gmoText     String?  @db.Text

  allergensText  String? @db.Text
  mayContainText String? @db.Text

  shelfLife         String?
  storageConditions String? @db.Text
  packagingText     String? @db.Text

  servingQuantity    Float?
  servingUnit        String?
  householdMeasure   String?
  servingsPerPackage String?

  baseQuantity Float  @default(100)
  baseUnit     String @default("g")

  reviewStatus ReviewStatus @default(PENDING)
  confidence   Float?

  approvedTargetType String?
  approvedTargetId   String?

  nutrients       ExtractedNutrient[]
  allergens       ExtractedAllergen[]
  technicalFields ExtractedTechnicalField[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, documentId])
}

model ExtractedNutrient {
  id String @id @default(cuid())

  extractionId String
  extraction   TechnicalSheetExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)

  nutrientKey String
  label       String

  value Float?
  unit  String?

  baseQuantity Float  @default(100)
  baseUnit     String @default("g")

  dailyValuePercent Float?

  sourceText String? @db.Text
  confidence Float?

  createdAt DateTime @default(now())

  @@index([extractionId])
  @@index([nutrientKey])
}

model ExtractedAllergen {
  id String @id @default(cuid())

  extractionId String
  extraction   TechnicalSheetExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)

  allergenKey String
  label       String

  declarationType String?
  present         Boolean?
  controlled      Boolean?

  sourceText String? @db.Text
  confidence Float?

  createdAt DateTime @default(now())

  @@index([extractionId])
  @@index([allergenKey])
}

model ExtractedTechnicalField {
  id String @id @default(cuid())

  extractionId String
  extraction   TechnicalSheetExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)

  category TechnicalFieldCategory
  fieldKey String
  label    String

  value      String? @db.Text
  unit       String?
  method     String?
  sourceText String? @db.Text
  confidence Float?

  createdAt DateTime @default(now())

  @@index([extractionId])
  @@index([category])
  @@index([fieldKey])
}

model EnterpriseLabelProject {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  baseTableId String?
  baseTable   GeneratedTable? @relation(fields: [baseTableId], references: [id], onDelete: SetNull)

  title  String
  market String
  status EnterpriseApprovalStatus @default(DRAFT)

  currentVersionId String?

  versions  EnterpriseLabelVersion[]
  approvals EnterpriseApproval[]
  exports   EnterpriseExport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, baseTableId, market])
  @@index([userId])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([baseTableId])
  @@index([market])
  @@index([status])
}

model EnterpriseLabelVersion {
  id String @id @default(cuid())

  projectId String
  project   EnterpriseLabelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  baseTableId String?
  baseTable   GeneratedTable? @relation(fields: [baseTableId], references: [id], onDelete: SetNull)

  version Int

  title          String
  market         String
  foodState      String
  approvalStatus EnterpriseApprovalStatus @default(DRAFT)

  tableSnapshot         Json
  legalData             Json?
  nutritionSnapshot     Json?
  validationSnapshot    Json?
  frontWarningsSnapshot Json?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, version])
  @@index([projectId])
  @@index([userId])
  @@index([baseTableId])
  @@index([market])
  @@index([approvalStatus])
}

model EnterpriseApproval {
  id String @id @default(cuid())

  projectId String
  project   EnterpriseLabelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status EnterpriseApprovalStatus
  owner  String?
  note   String?                  @db.Text

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([userId])
  @@index([status])
}

model EnterpriseExport {
  id String @id @default(cuid())

  projectId String
  project   EnterpriseLabelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  versionId String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  exportType EnterpriseExportType
  fileName   String?
  payload    Json?

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([versionId])
  @@index([userId])
  @@index([exportType])
}
