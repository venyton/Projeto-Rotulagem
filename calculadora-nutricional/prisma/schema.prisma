  @@unique([organizationId, baseTableId, market])
  @@index([userId])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([organizationId])
  @@index([organizationId, updatedAt(sort: Desc)])
  @@index([baseTableId])
  @@index([market])
  @@index([status])
}

model EnterpriseLabelVersion {
  id String @id @default(cuid())

  projectId String
  project   EnterpriseLabelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  baseTableId String?
  baseTable   GeneratedTable? @relation(fields: [baseTableId], references: [id], onDelete: SetNull)

  version Int

  title          String
  market         String
  foodState      String
  approvalStatus EnterpriseApprovalStatus @default(DRAFT)

  tableSnapshot         Json
  legalData             Json?
  nutritionSnapshot     Json?
  validationSnapshot    Json?
  frontWarningsSnapshot Json?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, version])
  @@index([projectId])
  @@index([userId])
  @@index([baseTableId])
  @@index([market])
  @@index([approvalStatus])
}

model EnterpriseApproval {
  id String @id @default(cuid())

  projectId String
  project   EnterpriseLabelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status EnterpriseApprovalStatus
  owner  String?
  note   String?                  @db.Text

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([userId])
  @@index([status])
}

model EnterpriseExport {
  id String @id @default(cuid())

  projectId String
  project   EnterpriseLabelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  versionId String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  exportType EnterpriseExportType
  fileName   String?
  payload    Json?

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([versionId])
  @@index([userId])
  @@index([exportType])
}
