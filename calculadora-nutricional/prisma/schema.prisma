generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

enum DocumentType {
  NUTRITION_TABLE_ONLY
  PRODUCT_TECHNICAL_SHEET
  MATERIAL_SPECIFICATION
  LAB_REPORT
  CERTIFICATE
  UNKNOWN
}

enum ExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVIEW
}

enum TechnicalFieldCategory {
  REGULATORY
  DECLARATION
  SENSORY
  PHYSICOCHEMICAL
  MICROBIOLOGICAL
  CONTAMINANT
  TRACEABILITY
  LOGISTICS
  CERTIFICATION
  WARNING
}

enum EnterpriseApprovalStatus {
  DRAFT
  QUALITY
  REGULATORY
  MARKETING
  APPROVED
}

enum EnterpriseExportType {
  PNG
  JSON
  GS1_DIGITAL_LINK
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganizationRole {
  OWNER
  ADMIN
  BILLING
  MEMBER
}

enum OrganizationKind {
  UNCLASSIFIED
  INDIVIDUAL
  COMPANY
}

enum OrganizationInvitationStatus {
  PENDING
  ACCEPTED
  CANCELED
  EXPIRED
}

enum SaaSModuleKey {
  TABLES
  CUSTOM_INGREDIENTS
  TECHNICAL_SHEETS
  OPEN_FOOD_FACTS
  ENTERPRISE_LABELS
  EXPORTS
  AI_IMPORT
  MARKETING_ANALYTICS
  API_ACCESS
  BILLING
  SETTINGS
}

// Tipos preservados do billing/marketing histórico. Novos fluxos comerciais
// devem evoluir esses contratos por migrations aditivas, sem assumir Stripe.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
  PAUSED
}

enum PaymentProvider {
  STRIPE
  ASAAS
  MANUAL
}

enum BillingCustomerStatus {
  PENDING
  ACTIVE
  SYNC_ERROR
}

enum BillingCheckoutStatus {
  CREATING
  ACTIVE
  PAID
  CANCELED
  EXPIRED
  FAILED
  OUTCOME_UNKNOWN
}

enum BillingChargeStatus {
  PENDING
  CONFIRMED
  RECEIVED
  OVERDUE
  CANCELED
  REFUNDED
  CHARGEBACK
}

enum BillingWebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum CommercialCouponStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CommercialDiscountType {
  PERCENT
  FIXED
}

enum CommercialGrantSourceType {
  COURTESY
  PARTNER
  SUPPORT
  MIGRATION
  OTHER
}

enum FeatureValueType {
  BOOLEAN
  QUOTA
  METERED
  SEAT_LIMIT
}

enum PlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PlanVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum BillingPriceStatus {
  ACTIVE
  ARCHIVED
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  YEARLY
}

enum EntitlementOverrideMode {
  ENABLE
  DISABLE
  SET_LIMIT
}

enum PlatformPermissionRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PlatformAssignmentStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum PrivilegedSessionStatus {
  PENDING_APPROVAL
  ACTIVE
  REVOKED
  EXPIRED
}

enum MarketingEventType {
  SIGNUP_STARTED
  SIGNUP_COMPLETED
  CHECKOUT_STARTED
  CHECKOUT_COMPLETED
  CHECKOUT_ABANDONED
  LOGIN
  MODULE_USED
  LEAD_CAPTURED
}

enum ConfigurationScope {
  GLOBAL
  ORGANIZATION
  USER
}

enum ConfigurationValueType {
  STRING
  INTEGER
  DECIMAL
  BOOLEAN
  JSON
  URL
}

model User {
  id                          String                        @id @default(cuid())
  email                       String                        @unique
  password                    String?
  name                        String?
  twoFactorEnabled            Boolean                       @default(false)
  twoFactorSecret             String?                       @db.Text
  twoFactorPendingSecret      String?                       @db.Text
  twoFactorConfirmedAt        DateTime?
  twoFactorLastUsedAt         DateTime?
  twoFactorLastUsedStep       Int?
  resetPasswordToken          String?                       @unique @db.Text
  resetPasswordExpiresAt      DateTime?
  termsAcceptedAt             DateTime?
  privacyAcceptedAt           DateTime?
  legalDocumentVersion        String?
  cpfHash                     String?                       @unique
  cpfLastFour                 String?
  ownedOrganizations          Organization[]                @relation("OrganizationOwner")
  organizationMemberships     OrganizationMember[]
  billingCustomers            BillingCustomer[]
  marketingEvents             MarketingEvent[]
  sentOrganizationInvitations OrganizationInvitation[]      @relation("OrganizationInvitationSender")
  securityAuditLogs           SecurityAuditLog[]
  platformAdminAssignments    PlatformAdminAssignment[]     @relation("PlatformAdminAssignmentUser")
  assignedPlatformAdmins      PlatformAdminAssignment[]     @relation("PlatformAdminAssignmentAssigner")
  requestedPrivilegedSessions PrivilegedSession[]           @relation("PrivilegedSessionRequester")
  approvedPrivilegedSessions  PrivilegedSession[]           @relation("PrivilegedSessionApprover")
  createdPlanVersions         PlanVersion[]                 @relation("PlanVersionCreator")
  createdFeatureGrants        OrganizationFeatureGrant[]    @relation("OrganizationFeatureGrantCreator")
  createdFeatureOverrides     OrganizationFeatureOverride[] @relation("OrganizationFeatureOverrideCreator")
  createdBillingCheckouts     BillingCheckoutAttempt[]      @relation("BillingCheckoutCreator")
  createdCommercialCoupons    CommercialCoupon[]            @relation("CommercialCouponCreator")
  createdCommercialGrants     CommercialGrant[]             @relation("CommercialGrantCreator")
  revokedCommercialGrants     CommercialGrant[]             @relation("CommercialGrantRevoker")
  tables                      GeneratedTable[]
  customIngredients           CustomIngredient[]
  technicalDocuments          TechnicalDocument[]
  technicalSheetExtractions   TechnicalSheetExtraction[]
  enterpriseLabelProjects     EnterpriseLabelProject[]
  enterpriseLabelVersions     EnterpriseLabelVersion[]
  enterpriseApprovals         EnterpriseApproval[]
  enterpriseExports           EnterpriseExport[]
  apiAccessTokens             ApiAccessToken[]
  usageEvents                 UsageEvent[]
  externalIdentities          ExternalIdentity[]
  configurationValues         ConfigurationValue[]          @relation("ConfigurationValueUser")
  updatedConfigurationValues  ConfigurationValue[]          @relation("ConfigurationValueUpdatedBy")
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt

  @@index([twoFactorEnabled])
}

model ExternalIdentity {
  id                String   @id @default(cuid())
  provider          String
  providerAccountId String
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PlatformRole {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String  @db.Text
  isSystem    Boolean @default(true)

  permissions PlatformRolePermission[]
  assignments PlatformAdminAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformPermission {
  id          String                      @id @default(cuid())
  key         String                      @unique
  name        String
  description String                      @db.Text
  riskLevel   PlatformPermissionRiskLevel @default(LOW)

  roles              PlatformRolePermission[]
  privilegedSessions PrivilegedSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([riskLevel])
}

model PrivilegedSession {
  id                       String                  @id @default(cuid())
  requestedByUserId        String
  requestedByUser          User                    @relation("PrivilegedSessionRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  approvedByUserId         String?
  approvedByUser           User?                   @relation("PrivilegedSessionApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  platformPermissionId     String
  platformPermission       PlatformPermission      @relation(fields: [platformPermissionId], references: [id], onDelete: Restrict)
  status                   PrivilegedSessionStatus @default(PENDING_APPROVAL)
  purpose                  String
  justification            String                  @db.Text
  ticketReference          String?
  targetType               String?
  targetId                 String?
  requestedDurationMinutes Int
  sessionBindingHash       String                  @db.Char(64)
  correlationId            String
  ipHash                   String?                 @db.Char(64)
  userAgent                String?                 @db.Text
  requestedAt              DateTime                @default(now())
  mfaVerifiedAt            DateTime
  approvedAt               DateTime?
  startedAt                DateTime?
  expiresAt                DateTime
  revokedAt                DateTime?
  auditLogs                SecurityAuditLog[]
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([requestedByUserId, status, expiresAt], map: "PrivilegedSession_requester_status_expiry_idx")
  @@index([platformPermissionId, status, expiresAt], map: "PrivilegedSession_permission_status_expiry_idx")
  @@index([approvedByUserId])
  @@index([correlationId])
}

model PlatformRolePermission {
  platformRoleId       String
  platformRole         PlatformRole       @relation(fields: [platformRoleId], references: [id], onDelete: Cascade)
  platformPermissionId String
  platformPermission   PlatformPermission @relation(fields: [platformPermissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([platformRoleId, platformPermissionId])
  @@index([platformPermissionId])
}

model PlatformAdminAssignment {
  id               String                   @id @default(cuid())
  userId           String
  user             User                     @relation("PlatformAdminAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  platformRoleId   String
  platformRole     PlatformRole             @relation(fields: [platformRoleId], references: [id], onDelete: Restrict)
  status           PlatformAssignmentStatus @default(ACTIVE)
  startsAt         DateTime                 @default(now())
  expiresAt        DateTime?
  assignedByUserId String?
  assignedByUser   User?                    @relation("PlatformAdminAssignmentAssigner", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status, startsAt, expiresAt])
  @@index([platformRoleId, status])
  @@index([assignedByUserId])
}

model Organization {
  id                       String             @id @default(cuid())
  ownerId                  String
  owner                    User               @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  name                     String
  slug                     String             @unique
  status                   OrganizationStatus @default(ACTIVE)
  kind                     OrganizationKind   @default(UNCLASSIFIED)
  cpfHash                  String?            @unique
  cpfLastFour              String?
  cnpjHash                 String?            @unique
  cnpjLastFour             String?
  legalName                String?
  tradeName                String?
  lupaStyleConfig          Json?
  entitlementPolicyVersion Int                @default(2)

  members                   OrganizationMember[]
  profiles                  OrganizationProfile[]
  invitations               OrganizationInvitation[]
  entitlements              OrganizationEntitlement[]
  featureGrants             OrganizationFeatureGrant[]
  featureOverrides          OrganizationFeatureOverride[]
  couponRedemptions         CouponRedemption[]
  commercialGrants          CommercialGrant[]
  billingCustomers          BillingCustomer[]
  subscriptions             Subscription[]
  billingCheckoutAttempts   BillingCheckoutAttempt[]
  billingCharges            BillingCharge[]
  billingWebhookEvents      BillingWebhookEvent[]
  marketingKeywords         MarketingKeyword[]
  marketingEvents           MarketingEvent[]
  securityAuditLogs         SecurityAuditLog[]
  apiAccessTokens           ApiAccessToken[]
  customIngredients         CustomIngredient[]
  tables                    GeneratedTable[]
  technicalDocuments        TechnicalDocument[]
  technicalSheetExtractions TechnicalSheetExtraction[]
  enterpriseLabelProjects   EnterpriseLabelProject[]
  usageEvents               UsageEvent[]
  usageAggregates           UsageAggregate[]
  configurationValues       ConfigurationValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([entitlementPolicyVersion])
}

model OrganizationMember {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId      String?
  profile        OrganizationProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  role           OrganizationRole     @default(MEMBER)
  active         Boolean              @default(true)

  moduleGrants    ParticipantModuleGrant[]
  marketingEvents MarketingEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([organizationId, role, createdAt])
  @@index([organizationId, profileId])
  @@index([userId])
  @@index([userId, active, createdAt])
  @@index([profileId])
  @@index([role])
}

model OrganizationInvitation {
  id              String                       @id @default(cuid())
  organizationId  String
  organization    Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email           String
  profileId       String?
  profile         OrganizationProfile?         @relation(fields: [profileId], references: [id], onDelete: SetNull)
  invitedByUserId String
  invitedByUser   User                         @relation("OrganizationInvitationSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  tokenHash       String                       @unique
  status          OrganizationInvitationStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  @@unique([organizationId, email])
  @@index([email, status, expiresAt])
  @@index([organizationId, status, createdAt])
  @@index([profileId])
}

model OrganizationProfile {
  id               String                     @id @default(cuid())
  organizationId   String
  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  description      String?                    @db.Text
  systemKey        String
  globalTemplateId String?
  globalTemplate   GlobalOrganizationProfile? @relation(fields: [globalTemplateId], references: [id], onDelete: SetNull)

  members     OrganizationMember[]
  invitations OrganizationInvitation[]
  permissions OrganizationProfilePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@unique([organizationId, systemKey])
  @@unique([organizationId, globalTemplateId])
  @@index([organizationId])
  @@index([globalTemplateId])
  @@index([organizationId, createdAt])
}

model GlobalOrganizationProfile {
  id          String  @id @default(cuid())
  name        String  @unique
  description String? @db.Text

  profiles    OrganizationProfile[]
  permissions GlobalOrganizationProfilePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GlobalOrganizationProfilePermission {
  id              String                    @id @default(cuid())
  globalProfileId String
  globalProfile   GlobalOrganizationProfile @relation(fields: [globalProfileId], references: [id], onDelete: Cascade)
  moduleKey       SaaSModuleKey
  enabled         Boolean                   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([globalProfileId, moduleKey], map: "GlobalOrganizationProfilePermission_globalProfileId_moduleKey_k")
  @@index([moduleKey])
}

model OrganizationProfilePermission {
  id                    String              @id @default(cuid())
  organizationProfileId String
  profile               OrganizationProfile @relation(fields: [organizationProfileId], references: [id], onDelete: Cascade)
  moduleKey             SaaSModuleKey
  enabled               Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationProfileId, moduleKey], map: "OrganizationProfilePermission_organizationProfileId_moduleKey_k")
  @@index([moduleKey])
  @@index([enabled])
}

model OrganizationEntitlement {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  moduleKey      SaaSModuleKey
  enabled        Boolean       @default(true)
  usageLimit     Int?
  source         String        @default("MANUAL")
  expiresAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, moduleKey])
  @@index([moduleKey])
  @@index([enabled])
}

model OrganizationFeatureGrant {
  id                  String            @id @default(cuid())
  organizationId      String
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  featureDefinitionId String
  featureDefinition   FeatureDefinition @relation(fields: [featureDefinitionId], references: [id], onDelete: Restrict)
  enabled             Boolean           @default(true)
  limitValue          Int?
  source              String
  reason              String            @db.Text
  startsAt            DateTime          @default(now())
  expiresAt           DateTime?
  createdByUserId     String?
  createdByUser       User?             @relation("OrganizationFeatureGrantCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([organizationId, featureDefinitionId, startsAt, expiresAt], map: "OrgFeatureGrant_org_feature_validity_idx")
  @@index([featureDefinitionId, startsAt, expiresAt], map: "OrgFeatureGrant_feature_validity_idx")
  @@index([createdByUserId])
}

model OrganizationFeatureOverride {
  id                  String                  @id @default(cuid())
  organizationId      String
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  featureDefinitionId String
  featureDefinition   FeatureDefinition       @relation(fields: [featureDefinitionId], references: [id], onDelete: Restrict)
  mode                EntitlementOverrideMode
  limitValue          Int?
  reason              String                  @db.Text
  startsAt            DateTime                @default(now())
  expiresAt           DateTime?
  createdByUserId     String?
  createdByUser       User?                   @relation("OrganizationFeatureOverrideCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([organizationId, featureDefinitionId, startsAt, expiresAt], map: "OrgFeatureOverride_org_feature_validity_idx")
  @@index([featureDefinitionId, startsAt, expiresAt], map: "OrgFeatureOverride_feature_validity_idx")
  @@index([createdByUserId])
}

model ParticipantModuleGrant {
  id                   String             @id @default(cuid())
  organizationMemberId String
  organizationMember   OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)
  moduleKey            SaaSModuleKey
  enabled              Boolean            @default(true)
  usageLimit           Int?
  expiresAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationMemberId, moduleKey])
  @@index([moduleKey])
  @@index([enabled])
}

// Objetos históricos criados em 20260515120000. Permanecem modelados para que
// schema e migration history não divirjam; as etapas comerciais seguintes os
// evoluem sem apagar dados nem tratar plano como permissão de usuário.
model Plan {
  id                      String                 @id @default(cuid())
  code                    String                 @unique
  name                    String
  description             String?                @db.Text
  monthlyPriceCents       Int                    @default(0)
  quarterlyPriceCents     Int                    @default(0)
  semiannualPriceCents    Int                    @default(0)
  yearlyPriceCents        Int                    @default(0)
  stripeMonthlyPriceId    String?
  stripeQuarterlyPriceId  String?
  stripeSemiannualPriceId String?
  stripeYearlyPriceId     String?
  active                  Boolean                @default(true)
  status                  PlanStatus             @default(DRAFT)
  isPaid                  Boolean                @default(true)
  archivedAt              DateTime?
  modules                 PlanModule[]
  versions                PlanVersion[]
  subscriptions           Subscription[]
  couponPlans             CommercialCouponPlan[]
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@index([active])
  @@index([status])
}

model PlanModule {
  id         String        @id @default(cuid())
  planId     String
  plan       Plan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  moduleKey  SaaSModuleKey
  usageLimit Int?
  enabled    Boolean       @default(true)
  createdAt  DateTime      @default(now())

  @@unique([planId, moduleKey])
  @@index([moduleKey])
}

model FeatureDefinition {
  id                      String                        @id @default(cuid())
  key                     String                        @unique
  name                    String
  description             String                        @db.Text
  moduleKey               SaaSModuleKey
  type                    FeatureValueType              @default(BOOLEAN)
  unit                    String?
  isActive                Boolean                       @default(true)
  defaultValueJson        Json?
  planVersions            PlanVersionFeature[]
  organizationGrants      OrganizationFeatureGrant[]
  organizationOverrides   OrganizationFeatureOverride[]
  commercialGrantFeatures CommercialGrantFeature[]
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt

  @@index([moduleKey, isActive])
  @@index([type, isActive])
}

model PlanVersion {
  id              String               @id @default(cuid())
  planId          String
  plan            Plan                 @relation(fields: [planId], references: [id], onDelete: Restrict)
  versionNumber   Int
  status          PlanVersionStatus    @default(DRAFT)
  publishedAt     DateTime?
  validFrom       DateTime?
  retiredAt       DateTime?
  createdByUserId String?
  createdByUser   User?                @relation("PlanVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  features        PlanVersionFeature[]
  prices          BillingPrice[]
  subscriptions   Subscription[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([planId, versionNumber])
  @@index([planId, status])
  @@index([status, publishedAt])
  @@index([createdByUserId])
}

model PlanVersionFeature {
  id                  String            @id @default(cuid())
  planVersionId       String
  planVersion         PlanVersion       @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  featureDefinitionId String
  featureDefinition   FeatureDefinition @relation(fields: [featureDefinitionId], references: [id], onDelete: Restrict)
  enabled             Boolean           @default(true)
  limitValue          Int?
  configJson          Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([planVersionId, featureDefinitionId])
  @@index([featureDefinitionId])
}

model BillingPrice {
  id               String                   @id @default(cuid())
  planVersionId    String
  planVersion      PlanVersion              @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  provider         String?
  providerPriceRef String?
  currency         String                   @default("BRL")
  amountMinor      Int
  billingInterval  BillingInterval
  status           BillingPriceStatus       @default(ACTIVE)
  archivedAt       DateTime?
  subscriptions    Subscription[]
  checkoutAttempts BillingCheckoutAttempt[]
  createdAt        DateTime                 @default(now())

  @@index([planVersionId, status])
  @@index([provider, providerPriceRef])
  @@index([currency, billingInterval, status])
}

model CommercialCoupon {
  id                            String                 @id @default(cuid())
  codeNormalized                String                 @unique
  name                          String
  discountType                  CommercialDiscountType
  discountValue                 Int
  currency                      String?
  startsAt                      DateTime
  endsAt                        DateTime
  maxRedemptions                Int?
  maxRedemptionsPerOrganization Int                    @default(1)
  status                        CommercialCouponStatus @default(DRAFT)
  createdByUserId               String
  createdByUser                 User                   @relation("CommercialCouponCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  plans                         CommercialCouponPlan[]
  redemptions                   CouponRedemption[]
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt

  @@index([status, startsAt, endsAt], map: "CommercialCoupon_status_validity_idx")
  @@index([createdByUserId])
}

model CommercialCouponPlan {
  couponId String
  coupon   CommercialCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  planId   String
  plan     Plan             @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@id([couponId, planId])
  @@index([planId])
}

model CouponRedemption {
  id                   String                  @id @default(cuid())
  couponId             String
  coupon               CommercialCoupon        @relation(fields: [couponId], references: [id], onDelete: Restrict)
  organizationId       String
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionId       String                  @unique
  subscription         Subscription            @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  checkoutAttempt      BillingCheckoutAttempt?
  redeemedAt           DateTime                @default(now())
  revokedAt            DateTime?
  originalAmountMinor  Int
  appliedDiscountMinor Int
  finalAmountMinor     Int
  currency             String                  @default("BRL")

  @@unique([couponId, organizationId, subscriptionId], map: "CouponRedemption_coupon_org_subscription_key")
  @@index([couponId, revokedAt, redeemedAt], map: "CouponRedemption_coupon_revoked_redeemed_idx")
  @@index([organizationId, couponId, revokedAt], map: "CouponRedemption_org_coupon_revoked_idx")
}

model CommercialGrant {
  id              String                    @id @default(cuid())
  organizationId  String
  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceType      CommercialGrantSourceType
  reason          String                    @db.Text
  startsAt        DateTime                  @default(now())
  expiresAt       DateTime?
  createdByUserId String
  createdByUser   User                      @relation("CommercialGrantCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revokedAt       DateTime?
