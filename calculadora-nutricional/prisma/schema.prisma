generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}


model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  tables    GeneratedTable[]
  customIngredients CustomIngredient[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ingredient {
  id        String   @id @default(cuid())
  name      String
  energy    Float    // kcal
  carbs     Float    // g
  protein   Float    // g
  fatTotal  Float    // g
  fatSat    Float    // g
  fatTrans  Float    // g
  fiber     Float    // g
  sodium    Float    // mg
  sugarTotal Float?  // g
  origin    String?  // "TACO", etc.

  // Micronutrients
  fatMono           Float?   @default(0)
  fatPoly           Float?   @default(0)
  omega6            Float?   @default(0)
  omega3            Float?   @default(0)
  cholesterol       Float?   @default(0)
  
  vitaminA          Float?   @default(0)
  vitaminD          Float?   @default(0)
  vitaminE          Float?   @default(0)
  vitaminK          Float?   @default(0)
  vitaminC          Float?   @default(0)
  thiamin           Float?   @default(0)
  riboflavin        Float?   @default(0)
  niacin            Float?   @default(0)
  vitaminB6         Float?   @default(0)
  biotin            Float?   @default(0)
  folicAcid         Float?   @default(0) // folate
  pantothenicAcid   Float?   @default(0)
  vitaminB12        Float?   @default(0)

  calcium           Float?   @default(0)
  chloride          Float?   @default(0)
  copper            Float?   @default(0)
  chromium          Float?   @default(0)
  iron              Float?   @default(0)
  fluoride          Float?   @default(0)
  phosphorus        Float?   @default(0)
  iodine            Float?   @default(0)
  magnesium         Float?   @default(0)
  manganese         Float?   @default(0)
  molybdenum        Float?   @default(0)
  potassium         Float?   @default(0)
  selenium          Float?   @default(0)
  zinc              Float?   @default(0)
  choline           Float?   @default(0)
}

model CustomIngredient {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  energy    Float
  carbs     Float
  protein   Float
  fatTotal  Float
  fatSat    Float
  fatTrans  Float
  fiber     Float
  sodium    Float
  sugarTotal Float
  sugarAdded Float    @default(0)

  // Micronutrients
  fatMono           Float?   @default(0)
  fatPoly           Float?   @default(0)
  omega6            Float?   @default(0)
  omega3            Float?   @default(0)
  cholesterol       Float?   @default(0)
  
  vitaminA          Float?   @default(0)
  vitaminD          Float?   @default(0)
  vitaminE          Float?   @default(0)
  vitaminK          Float?   @default(0)
  vitaminC          Float?   @default(0)
  thiamin           Float?   @default(0)
  riboflavin        Float?   @default(0)
  niacin            Float?   @default(0)
  vitaminB6         Float?   @default(0)
  biotin            Float?   @default(0)
  folicAcid         Float?   @default(0) // folate
  pantothenicAcid   Float?   @default(0)
  vitaminB12        Float?   @default(0)

  calcium           Float?   @default(0)
  chloride          Float?   @default(0)
  copper            Float?   @default(0)
  chromium          Float?   @default(0)
  iron              Float?   @default(0)
  fluoride          Float?   @default(0)
  phosphorus        Float?   @default(0)
  iodine            Float?   @default(0)
  magnesium         Float?   @default(0)
  manganese         Float?   @default(0)
  molybdenum        Float?   @default(0)
  potassium         Float?   @default(0)
  selenium          Float?   @default(0)
  zinc              Float?   @default(0)
  choline           Float?   @default(0)

  createdAt DateTime @default(now())
}

model GeneratedTable {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  portion   Float
  uom       String   // "g" or "ml"
  householdMeasure String
  popGroup  String   // "adultos", etc.
  items     TableItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TableItem {
  id        String   @id @default(cuid())
  tableId   String
  table     GeneratedTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  
  name      String
  quantity  Float    // g
  isAddedSugar Boolean @default(false)
  
  // Snapshotted nutritional values (per 100g)
  energy    Float
  carbs     Float
  protein   Float
  fatTotal  Float
  fatSat    Float
  fatTrans  Float
  fiber     Float
  sodium    Float
  sugarTotal Float?
}
