POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@localhost:5432/calculadora_nutricional?schema=calculadora_nutricional"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@localhost:5432/calculadora_nutricional?schema=calculadora_nutricional"
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/calculadora_nutricional?schema=calculadora_nutricional"
# Obrigatório em produção: segredo aleatório com no mínimo 32 caracteres.
NEXTAUTH_SECRET=
# Chave mestra dedicada para segredos cifrados no banco (mínimo 32 caracteres).
# Mantenha-a em um secret manager e estável durante toda a vida dos dados cifrados.
SECRET_ENCRYPTION_KEY=
# Opcional. Se vazio, o 2FA usa NEXTAUTH_SECRET para criptografar os segredos TOTP.
TWO_FACTOR_ENCRYPTION_KEY=
RATE_LIMIT_HASH_SALT=
ANALYTICS_HASH_SALT=
NEXTAUTH_URL=http://localhost:3000
# Deixe vazio para usar false em desenvolvimento e true em produção.
SESSION_COOKIE_SECURE=
# Ative apenas em self-hosted atrás de proxy que sobrescreve/normaliza X-Forwarded-For.
# Na Vercel, usa-se o cabeçalho assinado x-vercel-forwarded-for.
TRUST_PROXY_HEADERS=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
INTERNAL_MASTER_EMAILS=
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=SoIZI <no-reply@example.com>

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_CLIENT_ID=
META_CLIENT_SECRET=
MICROSOFT_ENTRA_ID_CLIENT_ID=
MICROSOFT_ENTRA_ID_CLIENT_SECRET=
MICROSOFT_ENTRA_TENANT_ID=common

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TECHNICAL_SHEET_MAX_FILE_SIZE_MB=20
TECHNICAL_SHEET_MAX_BATCH_FILES=5
TECHNICAL_SHEET_MAX_BATCH_SIZE_MB=80
# Limite geral opcional do corpo da requisição em MB. Vercel aplica 4 MB automaticamente.
MAX_RUNTIME_REQUEST_BODY_MB=
# Limite opcional do Server Action em self-hosted. Vercel aplica 4 MB automaticamente.
NEXT_SERVER_ACTION_BODY_SIZE_LIMIT=

# Rate limits persistentes; os padrões documentados ficam no runbook operacional.
REQUEST_LIMIT_OPEN_FOOD_FACTS_SEARCH_PER_WINDOW=8
REQUEST_LIMIT_OPEN_FOOD_FACTS_PRODUCT_PER_WINDOW=12
REQUEST_LIMIT_OPEN_FOOD_FACTS_USER_PER_WINDOW=30
REQUEST_LIMIT_EXPORTS_PER_WINDOW=5
REQUEST_LIMIT_TABLE_WRITES_PER_WINDOW=30
REQUEST_LIMIT_INGREDIENT_WRITES_PER_WINDOW=30
REQUEST_LIMIT_INGREDIENT_SEARCH_PER_WINDOW=120
REQUEST_LIMIT_TECHNICAL_SHEET_REVIEWS_PER_WINDOW=30
REQUEST_LIMIT_WORKSPACE_WRITES_PER_WINDOW=20
REQUEST_LIMIT_API_TABLES_PER_WINDOW=60
REQUEST_LIMIT_GEMINI_PROJECT_PER_WINDOW=5
REQUEST_LIMIT_GEMINI_USER_PER_WINDOW=50
REQUEST_LIMIT_LOGIN_IP_PER_WINDOW=30
REQUEST_LIMIT_REGISTRATION_GLOBAL_PER_WINDOW=100
REQUEST_LIMIT_PASSWORD_RESET_GLOBAL_PER_WINDOW=60
REQUEST_LIMIT_READINESS_PER_WINDOW=60

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTH=
STRIPE_PRICE_STARTER_QUARTER=
STRIPE_PRICE_STARTER_SEMESTER=
STRIPE_PRICE_STARTER_YEAR=
STRIPE_PRICE_PROFESSIONAL_MONTH=
STRIPE_PRICE_PROFESSIONAL_QUARTER=
STRIPE_PRICE_PROFESSIONAL_SEMESTER=
STRIPE_PRICE_PROFESSIONAL_YEAR=
STRIPE_PRICE_ENTERPRISE_MONTH=
STRIPE_PRICE_ENTERPRISE_QUARTER=
STRIPE_PRICE_ENTERPRISE_SEMESTER=
STRIPE_PRICE_ENTERPRISE_YEAR=

# Rollout server-side não financeiro. A integração Asaas, checkout e processamento
# de seus webhooks são ativados pelo registro global no banco.
CONTROL_PLANE_ENABLED=false
CUSTOMER_PLAN_UI_ENABLED=false
# Fora do escopo do MVP; configurar true faz a aplicação recusar o rollout.
PIX_AUTOMATICO_ENABLED=false
TREASURY_AUTOMATION_ENABLED=false

NEXT_PUBLIC_MARKETING_TRACKING_ENABLED=true
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
